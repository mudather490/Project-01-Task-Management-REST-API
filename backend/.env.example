# Copy to backend/.env and adjust values

APP_NAME=Task Management API
DEBUG=true

# Local development defaults to SQLite. In production, point this to
# Turso (serverless SQLite), for example:
# DATABASE_URL=libsql://<your-database>.<your-account>.turso.io?authToken=<token>
# The backend converts libsql:// to sqlite+libsql://&secure=true internally.
# (Neon/Supabase Postgres URLs, postgresql://..., are also accepted.)
DATABASE_URL=sqlite:///./task_management.db

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
